# Copy to .env and fill in. Never commit a real .env.
ENVIRONMENT=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assignment_roaster
# Used outside docker; docker-compose overrides host to "db"
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/assignment_roaster

# ENVIRONMENT=production REQUIRES a random SECRET_KEY of >= 32 characters (placeholders and
# short values are rejected at startup) AND a GITHUB_TOKEN. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub OAuth (login). Create an OAuth App at https://github.com/settings/developers.
# In docker-compose the API is reached through nginx on port 3000, so the
# "Authorization callback URL" to register is exactly:
#   http://localhost:3000/api/v1/auth/github/callback
# (running the backend directly on :8000 instead? set BACKEND_PUBLIC_URL=http://localhost:8000
#  and register http://localhost:8000/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-secret
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6.1-sol
# Leave empty if you have none in development (a fake value makes GitHub reject requests).
# Required when ENVIRONMENT=production.
GITHUB_TOKEN=

# Cost / abuse controls
MAX_SUBMISSIONS_PER_DAY=20
MAX_IN_FLIGHT_PER_USER=2
DAILY_ANALYSIS_BUDGET=500
STALE_SUBMISSION_MINUTES=15
PIPELINE_TIMEOUT_SECONDS=300

# Local dev (vite dev server) only: calls the backend directly.
VITE_API_URL=http://localhost:8000
# Docker image build: leave empty so the SPA calls /api/v1 through nginx.
DOCKER_VITE_API_URL=
